<Window x:Class="AppLocker.Manager.Guard.LockChipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locker" Width="184" Height="46"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Opacity="0">

    <Grid Margin="4">
        <!-- Inex Island Obsidian Glass Pill -->
        <Border x:Name="Card" CornerRadius="8" Background="#F00E0D0A" BorderBrush="#32312E" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000" Direction="270"/>
            </Border.Effect>

            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon -->
                <TextBlock x:Name="ChipIcon" Grid.Column="0" Text="&#xE785;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <!-- Folder Label -->
                <TextBlock x:Name="ChipLabel" Grid.Column="1" Text="Folder" Foreground="#F7F6F3"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="72" ToolTip="Unlocked folder"/>

                <!-- Lock Now Button -->
                <Button x:Name="LockBtn" Grid.Column="2" Content="Lock now" Height="22"
                        Cursor="Hand" VerticalAlignment="Center" Margin="6,0,0,0"
                        Click="LockBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#0C0B08"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E4E3E0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
