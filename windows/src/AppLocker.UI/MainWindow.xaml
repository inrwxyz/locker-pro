<Window x:Class="AppLocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Locker" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Opacity="0">
    <Window.Resources>
        <!-- Rong ekhane bodlano jabe: Glass = card er opacity, Line = border -->
        <SolidColorBrush x:Key="Glass" Color="#A6000000"/>
        <SolidColorBrush x:Key="Line" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Soft" Color="#CCFFFFFF"/>
        <DropShadowEffect x:Key="TS" Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.85"/>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border x:Name="Card" CornerRadius="16" Background="{StaticResource Glass}"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShakeTransform" X="0"/>
            </Border.RenderTransform>

            <StackPanel x:Name="Body" Margin="22">
                <!-- Icon / dots (+ chip e Lock now button) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid x:Name="IconGrid" Width="40" Height="40">
                        <TextBlock x:Name="GlyphIcon" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="30" Foreground="White" Effect="{StaticResource TS}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Ellipse x:Name="D1" Width="6" Height="6" Margin="2,0" Fill="White"/>
                            <Ellipse x:Name="D2" Width="6" Height="6" Margin="2,0" Fill="White"/>
                            <Ellipse x:Name="D3" Width="6" Height="6" Margin="2,0" Fill="White"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="LockNowBtn" ToolTip="Lock now" Visibility="Collapsed"
                            Click="LockNowBtn_Click" Cursor="Hand" Focusable="False"
                            Margin="10,0,0,0" Width="24" Height="24" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                                        BorderBrush="White" BorderThickness="1">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#77FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="ItemName" Text="Locked item" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"
                           TextTrimming="CharacterEllipsis" MaxWidth="280" Effect="{StaticResource TS}"/>
                <TextBlock x:Name="Status" Text="Password dao" Foreground="{StaticResource Soft}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,2" Effect="{StaticResource TS}"/>

                <!-- Password form -->
                <StackPanel x:Name="FormPanel" Margin="0,12,0,0">
                    <Grid>
                        <PasswordBox x:Name="PwBox" Height="38" FontSize="15" Padding="10,8,40,8"
                                     Background="#33000000" Foreground="White" CaretBrush="White"
                                     BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                        <TextBox x:Name="PwText" Height="38" FontSize="15" Padding="10,8,40,8"
                                 Background="#33000000" Foreground="White" CaretBrush="White"
                                 BorderBrush="{StaticResource Line}" BorderThickness="1" Visibility="Collapsed"/>
                        <Button x:Name="EyeBtn" Content="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                HorizontalAlignment="Right" Width="38" Height="38"
                                Background="Transparent" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="EyeBtn_Click"/>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CancelBtn" Grid.Column="0" Content="Cancel" Height="36"
                                Style="{StaticResource PlainButton}" Background="Transparent"
                                Click="CancelBtn_Click"/>
                        <Button x:Name="UnlockBtn" Grid.Column="2" Content="Unlock" Height="36"
                                Style="{StaticResource PlainButton}" Background="#26FFFFFF"
                                FontWeight="SemiBold" IsDefault="True" Click="UnlockBtn_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
